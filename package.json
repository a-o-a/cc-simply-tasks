{
  "name": "cc-simply-tasks",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "node scripts/test.cjs",
    "test:integration": "node scripts/integration.cjs",
    "test:lint": "node scripts/test-lint.cjs",
    "test:smoke": "node --test scripts/smoke.test.mjs",
    "test:ui": "node --test --test-concurrency=1 scripts/ui.test.mjs scripts/release-ui.test.mjs scripts/pagination-regression.test.mjs scripts/interaction-regression.test.mjs scripts/activity-ui-regression.test.mjs scripts/gantt-regression.test.mjs scripts/dashboard-regression.test.mjs",
    "test:regression": "node --test scripts/date-regression.test.mjs scripts/todo-regression.test.mjs scripts/calendar-range.test.mjs scripts/relation-audit-regression.test.mjs scripts/cursor-pagination.test.mjs",
    "benchmark": "node scripts/benchmark-pagination.mjs",
    "benchmark:cursor": "node scripts/benchmark-cursor-pagination.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:lint && npm test && npm run build && npm run test:smoke && npm run test:regression"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@libsql/client": "0.18.0",
    "@paralleldrive/cuid2": "3.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.57.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "node-cron": "4.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.23.3",
    "@next/eslint-plugin-next": "16.4.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "@playwright/test": "1.64.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
