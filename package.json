    "test:ui": "node --test scripts/ui.test.mjs scripts/release-ui.test.mjs scripts/pagination-regression.test.mjs",
    "test:regression": "node --test scripts/date-regression.test.mjs scripts/todo-regression.test.mjs scripts/calendar-range.test.mjs",
